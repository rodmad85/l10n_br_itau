<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_itau_wizard" model="ir.ui.view">
    <field name="name">itau.statement.wizard.form</field>
    <field name="model">itau.statement.wizard</field>
    <field name="arch" type="xml">
        <form string="Importar Extrato Itaú">
            <group>
                <field name="journal_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
            </group>
            <footer>
                <button string="Importar"
                        type="object"
                        name="action_import"
                        class="btn-primary"/>
                <button string="Cancelar" special="cancel"/>
            </footer>
        </form>
    </field>
</record>
    </data>
</odoo>