<odoo>

    <!-- Herda as configurações gerais -->
    <record id="view_res_config_settings_itau" model="ir.ui.view">
        <field name="name">res.config.settings.itau</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.view_res_config_settings"/>
        <field name="arch" type="xml">

            <!-- Adiciona seção dentro das configurações -->
            <xpath expr="//div[hasclass('settings')]" position="inside">

                <div class="app_settings_block" data-string="Integração Itaú" string="Integração Itaú">

                    <h2>Itaú API</h2>

                    <div class="row mt16 o_settings_container">

                        <!-- CLIENT ID -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="itau_client_id"/>
                                <field name="itau_client_id"/>
                                <div class="text-muted">
                                    Client ID fornecido pelo Itaú
                                </div>
                            </div>
                        </div>

                        <!-- CLIENT SECRET -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="itau_client_secret"/>
                                <field name="itau_client_secret" password="True"/>
                                <div class="text-muted">
                                    Client Secret da aplicação
                                </div>
                            </div>
                        </div>

                        <!-- API KEY -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="itau_api_key"/>
                                <field name="itau_api_key"/>
                                <div class="text-muted">
                                    Chave da API (x-itau-apikey)
                                </div>
                            </div>
                        </div>

                        <!-- AMBIENTE -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="itau_environment"/>
                                <field name="itau_environment"/>
                                <div class="text-muted">
                                    Escolha entre Sandbox ou Produção
                                </div>
                            </div>
                        </div>

                    </div>

                </div>

            </xpath>

        </field>
    </record>

</odoo>